// branch_f1_v1 | category: branch-heavy | family: branch_f1
int a = 0;
int b = 0;
int c = 0;
int i = 0;
while (i < 49) {
    if (i % 3 == 0) {
        a = a + 1;
    } else {
        if (i % 5 == 0) {
            b = b + 1;
        } else {
            c = c + 1;
        }
    }
    i = i + 1;
}
print(a);
print(b);
print(c);
